{
  "name": "nyasavault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=5173 --host=0.0.0.0",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/index.js",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "test": "NODE_ENV=test tsx --test server/test/*.test.ts",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist dist-server",
    "serve": "node --env-file-if-exists=.env server/index.ts"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@tailwindcss/vite": "^4.3.3"
  },
  "description": "NyasaVault: Malawi cloud banking (mobile money, KYC-gated virtual card, crypto, P2P escrow)",
  "engines": {
    "node": ">=22.13"
  }
}
