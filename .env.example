# ---- Core ----
NODE_ENV=production
PORT=3000
APP_URL=https://app.yourdomain.mw        # exact public origin (used for CSRF origin check)
DATA_DIR=/data                           # SQLite DB + KYC documents live here: mount a persistent volume
TRUST_PROXY=true                         # true when behind a load balancer / reverse proxy

# ---- Secrets (generate each: openssl rand -base64 48) ----
ENCRYPTION_KEY=
WEBHOOK_SECRET=
ADMIN_API_KEY=

# ---- Providers ----
# sandbox = fake money, for staging/testing.  live = real providers (needs the credentials below).
PROVIDER_MODE=live
# Only for a clearly labelled staging site; never for real customers:
# ALLOW_SANDBOX_IN_PROD=true

# Airtel Money Open API (collections). Verify endpoints against your merchant docs.
AIRTEL_BASE_URL=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
# TNM Mpamba / bank rails / card issuer / crypto custody: integrate your partner APIs in server/providers/

# ---- Pricing & limits ----
USD_MWK_RATE=1751
CRYPTO_SPREAD_BPS=150
TIER1_DAILY_MWK=150000
TIER2_DAILY_MWK=5000000
TIER3_DAILY_MWK=20000000
AML_REPORT_THRESHOLD_MWK=5000000
